{
  "manifest_version": 3,
  "name": "App Store 网页版地区切换助手",
  "short_name": "AppStoreRegion",
  "version": "3.3.1",
  "description": "在真实的 apps.apple.com 上切换商店地区。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "App Store 地区切换",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "proxy",
    "alarms"
  ],
  "host_permissions": [
    "*://apps.apple.com/*",
    "https://itunes.apple.com/*",
    "http://127.0.0.1:17890/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://apps.apple.com/*"
      ],
      "js": [
        "regions.js",
        "storefront.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "呼出 App Store 地区切换面板"
    }
  }
}
